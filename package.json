{
  "name": "boss-shop",
  "version": "1.3.4",
  "type": "module",
  "private": true,
  "author": "Boss Shop",
  "description": "Учет товаров, продаж и прибыли магазина мужской одежды",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/generate-icon.cjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run assets && npm run build && electron-builder --win nsis",
    "check": "tsc -b --pretty false",
    "test": "node tests/integration.cjs && node tests/backup.cjs && node tests/import.cjs && node tests/persistence.cjs && node tests/stock-cost.cjs && node tests/sale-edit.cjs && node tests/product-model.cjs && node tests/catalog.cjs",
    "test:electron": "node tests/electron-runtime.cjs"
  },
  "dependencies": {
    "date-fns": "latest",
    "fflate": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "22.3.27",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "ru.bossshop.inventory",
    "productName": "Boss Shop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BossShop-Setup-${version}-Win7-8-10-11-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
